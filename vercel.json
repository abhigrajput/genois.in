{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/trial-reminder",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire-trials",
      "schedule": "0 2 * * *"
    }
  ]
}
