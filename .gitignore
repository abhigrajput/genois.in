# Generated by Next on every run, and NOT stably: `next dev` writes
# ./.next/dev/types/... while `next build` writes ./.next/types/... , so a
# tracked copy flips back and forth and shows dirty after whichever you ran
# last. next build regenerates it before typechecking, and tsconfig lists it
# under "include" (missing entries are skipped, not an error), so nothing
# depends on it being in the repo.
next-env.d.ts
